'use strict';

const fs = require('node:fs');
const path = require('node:path');

const root = process.cwd();
const exitControlPath = path.join(root, 'pnpm-recorder-exit.txt');
const modeControlPath = path.join(root, 'pnpm-recorder-mode.txt');
const exitCode = fs.existsSync(exitControlPath)
  ? Number(fs.readFileSync(exitControlPath, 'utf8'))
  : 0;
const mode = fs.existsSync(modeControlPath)
  ? fs.readFileSync(modeControlPath, 'utf8')
  : 'exit';
const selectedEnvironment = {};
for (const key of [
  'ANDROID_HOME',
  'ANDROID_SDK_ROOT',
  'CI',
  'JAVA_HOME',
  'QUALITY_GATE_V2_BOOTSTRAP_SELF_SHA256',
  'QUALITY_GATE_FORBIDDEN_SECRET',
]) {
  selectedEnvironment[key] = Object.prototype.hasOwnProperty.call(
    process.env,
    key,
  )
    ? process.env[key]
    : null;
}

fs.writeFileSync(
  path.join(root, 'pnpm-recorder.json'),
  JSON.stringify({
    argv: process.argv.slice(2),
    cwd: root,
    environment: selectedEnvironment,
  }),
  'utf8',
);
process.stdout.write('PNPM_RECORDER_STDOUT:' + String(exitCode));
process.stderr.write('PNPM_RECORDER_STDERR:' + String(exitCode));
if (mode === 'ready-pid-hold') {
  fs.writeFileSync(
    path.join(root, 'pnpm-recorder-ready-pid.txt'),
    String(process.pid),
    'utf8',
  );
  process.stdin.resume();
} else if (mode === 'exit') {
  process.exitCode = exitCode;
} else {
  process.stderr.write(':UNKNOWN_RECORDER_MODE');
  process.exitCode = 64;
}
