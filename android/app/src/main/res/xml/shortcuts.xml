      android:enabled="true"
      android:icon="@mipmap/start_five_launcher"
      android:shortcutShortLabel="@string/shortcut_start_five_short"
      android:shortcutLongLabel="@string/shortcut_start_five_long">
        <intent
          android:action="com.startfive.app.SHORTCUT_START_FIVE"
          android:targetPackage="com.startfive.app"
